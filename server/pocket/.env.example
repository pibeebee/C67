POCKET_READ_TOKEN=
# Local development defaults to legacy shared-token mode. Do not distribute that token.
POCKET_AUTH_MODE=legacy
# Required when POCKET_AUTH_MODE=authenticated; client key is publishable, never service-role.
SUPABASE_URL=
SUPABASE_CLIENT_KEY=
# Optional account deletion in authenticated mode. Set only on the server after applying the deletion migration.
SUPABASE_SERVICE_ROLE_KEY=
POCKET_APPLE_SIGN_IN_CLIENT_ID=
POCKET_APPLE_SIGN_IN_KEY_ID=
POCKET_APPLE_SIGN_IN_PRIVATE_KEY=
# Apple Developer Team ID is used by Sign in with Apple and WeatherKit.
APPLE_TEAM_ID=
# Optional WeatherKit REST credentials; keep the signing key private and server-side.
APPLE_WEATHER_SERVICE_ID=
APPLE_WEATHER_KEY_ID=
APPLE_WEATHER_PRIVATE_KEY=
POCKET_LLM_PROTOCOL=responses
POCKET_LLM_BASE_URL=https://ai.giovanc.com/v1
POCKET_LLM_API_KEY=
# Alternatively load the provider key from a private file supported by visit_advice.py:
# POCKET_LLM_ENV_FILE=/absolute/path/to/private.env

# Optional server-only business-hours provider. Never embed this credential in the app.
# POCKET_HOURS_BASE_URL=https://your-authorized-hours-service.example
# POCKET_HOURS_TOKEN=
