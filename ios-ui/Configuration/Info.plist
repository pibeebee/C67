<plist version="1.0">
<dict>
	<key>C67_DATA_MODE</key>
	<string>$(C67_DATA_MODE)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>SUPABASE_CLIENT_KEY</key>
	<string>$(SUPABASE_CLIENT_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_SCHEME)://$(SUPABASE_HOST)</string>
</dict>
</plist>
