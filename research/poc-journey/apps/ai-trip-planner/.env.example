# Copy to .env locally. Never put real keys in examples, reports, or Git.
# V4 default: only this key is required. Enable Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=
# The following AI/browser settings are only for legacy experiments (v1-v3).
# V4 does not read an AI key, call a model, or launch a browser.
OPENROUTER_API_KEY=
# Choose an explicit base model. V3 requires a compatible native tool-calling endpoint; legacy commands use structured_outputs.
OPENROUTER_MODEL=
# Maximum completion tokens per AI call (256..32768).
# This budget includes reasoning tokens when the model enables reasoning.
OPENROUTER_MAX_TOKENS=16384
# auto: model defaults; on/off: explicitly request reasoning.enabled=true/false.
OPENROUTER_REASONING=on
# Optional request timeout (1000..180000 ms); defaults: on=180000, otherwise=30000.
OPENROUTER_TIMEOUT_MS=180000
# Total input + reasoning + visible output cap; provider's smaller limit still applies.
OPENROUTER_CONTEXT_LIMIT=1000000

# Browser planning. No new search API key is needed for the isolated browser.
# Buffers are explicit planning assumptions, not provider guarantees.
POC_WALK_BUFFER_MINUTES=5
POC_TRANSIT_BUFFER_MINUTES=10
# Legacy v2 only:
POC_MAX_PLAN_ATTEMPTS=3
# Google requests across initial collection + all simulations in this run.
POC_MAX_ROUTE_REQUESTS=150
# Includes AI-directed browser research and proposal/repair calls.
POC_MAX_MODEL_CALLS=48
# Aggregate input + completion across all model calls in a run.
# Missing usage is charged at the conservative preflight reservation.
POC_MAX_RUN_TOKENS=1000000
POC_EVIDENCE_MAX_AGE_MINUTES=60

# V3: empty role model means inherit OPENROUTER_MODEL. Actual .env is never rewritten.
OPENROUTER_RESEARCHER_MODEL=
OPENROUTER_PLANNER_MODEL=
OPENROUTER_REVIEWER_MODEL=
# Per-role defaults are at least 32768, even when the legacy completion setting is 16384.
# 1024..131072, subject to the chosen provider/model and context limit.
OPENROUTER_RESEARCHER_MAX_TOKENS=32768
OPENROUTER_PLANNER_MAX_TOKENS=32768
OPENROUTER_REVIEWER_MAX_TOKENS=32768
# 1000..600000 milliseconds per role request; model support still applies.
OPENROUTER_RESEARCHER_TIMEOUT_MS=300000
OPENROUTER_PLANNER_TIMEOUT_MS=300000
OPENROUTER_REVIEWER_TIMEOUT_MS=300000
# Quality/completeness determines success; these are termination guards only.
POC_AGENT_MAX_TURNS=24
POC_QUALITY_MAX_CYCLES=8
