    "documentEncodes" : 3,
    "documents" : [
      {
        "id" : "bdt-rbbj",
        "sourceIDs" : [
          "benefit-bdt-home"
        ],
        "text" : "A social reading room permits food and beverages. Visitors can read books here and converse; piano and literary events are described for this shared room."
      },
      {
        "id" : "bdt-silent",
        "sourceIDs" : [
          "benefit-bdt-faq"
        ],
        "text" : "A dedicated silent reading and study room. Food, drinks and telephone or online conversations are prohibited by its published room rules."
      },
      {
        "id" : "bdt-cafe",
        "sourceIDs" : [
          "benefit-bdt-home"
        ],
        "text" : "A social cafe area for conversation and coffee. Permission for sustained on-site reading in this cafe scope has not been established by the supplied evidence."
      },
      {
        "id" : "newsroom",
        "sourceIDs" : [
          "benefit-newsroom"
        ],
        "text" : "A media and creative community space with specialty coffee, selected independent publications, design titles and a mini library. Its operator describes inspiration, exchanging ideas and connecting creative industries. Wi-Fi and a smoking area are listed."
      },
      {
        "id" : "bakoel-cikini",
        "sourceIDs" : [
          "benefit-bakoel"
        ],
        "text" : "Coffee served in an old colonial shophouse in the Menteng district. The operator describes a meeting place for people from different backgrounds near an arts center."
      },
      {
        "id" : "dialogue",
        "sourceIDs" : [
          "benefit-dialogue"
        ],
        "text" : "A collective public art space connecting artists, designers and local communities. Its program promotes experimentation, emerging creators and design through changing exhibits and community collaboration."
      },
      {
        "id" : "erasmus",
        "sourceIDs" : [
          "benefit-erasmus"
        ],
        "text" : "An indoor library with Dutch literature, translations into English and Indonesian, and publications on Indonesian history and Dutch-Indonesian cultural relations. Visitors may read on site; membership is required to borrow titles."
      },
      {
        "id" : "ragunan",
        "sourceIDs" : [
