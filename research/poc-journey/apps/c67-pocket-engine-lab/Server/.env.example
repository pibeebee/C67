# Copy to Server/.env. No credentials are inherited from other labs.
POCKET_HOST=127.0.0.1
POCKET_PORT=8792
# Generate separate random values locally; do not reuse provider keys as tokens.
POCKET_READ_TOKEN=
POCKET_WRITE_TOKEN=
# Optional. Blank disables the TomTom comparison endpoint.
TOMTOM_API_KEY=
# Persisted request reservations, per UTC day, including failed attempts.
TOMTOM_DAILY_CAP=20
# On macOS Python installations without a default CA bundle, use the system bundle.
# SSL_CERT_FILE=/etc/ssl/cert.pem

# Luna: existing private provider .env file OR direct server-only key.
# Quote paths containing spaces. Model is pinned in code to cx/gpt-6-luna(max).
POCKET_LLM_ENV_FILE=
POCKET_LLM_API_KEY=

# Required for live advice; use the privately configured provider base (including /v1).
POCKET_LLM_BASE_URL=
POCKET_LUNA_DAILY_CAP=20
