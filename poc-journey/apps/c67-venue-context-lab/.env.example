# Load privately into the server process. Keep real credentials out of this file.
LAB_ACCESS_TOKEN=
LAB_HOST=127.0.0.1
LAB_PORT=8788
LAB_DATA_DIR=.local

APPLE_TEAM_ID=
MAPS_KEY_ID=
MAPS_KEY_PATH=
WEATHER_KEY_ID=
WEATHER_KEY_PATH=
WEATHER_SERVICE_ID=

FIRECRAWL_API_KEY=
# Enable only after checking the Firecrawl dashboard (pay-as-you-go disabled)
# and running the read-only connection check in README.md.
VENUE_ENRICHMENT_ENABLED=0
VENUE_WEB_PROVIDER=playwright
VENUE_PLAYWRIGHT_MAX_PAGES=5
# Optional: Firecrawl searches for URLs; Playwright still reads the pages.
VENUE_URL_DISCOVERY=none
VENUE_FIRECRAWL_CREDIT_CAP=150
GIOVANC_API_KEY=
GIOVANC_MODEL="cx/gpt-6-luna(max)"
GIOVANC_TIMEOUT_SECONDS=90

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
